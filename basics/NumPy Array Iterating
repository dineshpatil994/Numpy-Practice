# Iterating Arrays Using nditer()
# 3.The function nditer() is a helping function that can be used from very basic to very advanced iterations.
import numpy as np

arr2 = np.array([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])

for r in np.nditer(arr2):
  print(r)

for s in np.nditer(arr2, flags=['buffered'], op_dtypes=['S']):
  print(s)
    
# 4.Iterating With Different Step Size
import numpy as np

arr3 = np.array([[1, 2, 3, 4], [5, 6, 7, 8]])

for v in np.nditer(arr3[:, ::2]):
  print(v)
for idx, d in np.ndenumerate(arr3):
  print(idx, d)
